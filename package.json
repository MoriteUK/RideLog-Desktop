{
  "name": "ride-weight-log",
  "version": "1.9.32",
  "description": "325km x8 - Ride & Weight Log (Audax training tracker)",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/MoriteUK/RideLog-Desktop.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "publish": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.andywhite.ridelog",
    "productName": "RideLog",
    "icon": "assets/bicyclist.ico",
    "publish": {
      "provider": "github",
      "owner": "MoriteUK",
      "repo": "RideLog-Desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**"
    ],
    "win": {
      "icon": "assets/bicyclist.ico",
      "target": "nsis",
      "publisherName": "Andy White"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RideLog",
      "installerIcon": "assets/bicyclist.ico",
      "uninstallerIcon": "assets/bicyclist.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "author": "Andy White",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "garmin-connect": "^1.6.2"
  }
}
